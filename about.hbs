<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Hekate: third-party licenses (Rust)</title>
  </head>
  <body>
    <h1>Third-party licenses (Rust dependencies)</h1>
    <p>The WASM module of Hekate contains code from these crates.</p>
    <h2>Licenses that are used</h2>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}} crates)</li>
      {{/each}}
    </ul>
    {{#each licenses}}
    <section id="{{id}}">
      <h3>{{name}}</h3>
      <p>Used by:</p>
      <ul>
        {{#each used_by}}
        <li>{{crate.name}} {{crate.version}}</li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
    {{/each}}
  </body>
</html>
