    "build": "cargo xtask dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "prettier": "^3.9.9",
    "globals": "^17.13.0"
  }
}
